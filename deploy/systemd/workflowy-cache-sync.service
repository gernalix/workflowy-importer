[Unit]
Description=Refresh local Workflowy SQLite cache
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/workflowy-importer
Environment=PYTHONPATH=%h/projects/workflowy-importer/src
ExecStart=/usr/bin/python3 -m workflowy_importer.bridge_cli sync
NoNewPrivileges=true
PrivateTmp=true
