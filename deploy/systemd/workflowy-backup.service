[Unit]
Description=Create daily Workflowy JSON backup

[Service]
Type=oneshot
WorkingDirectory=%h/projects/workflowy-importer
Environment=PYTHONPATH=%h/projects/workflowy-importer/src
ExecStart=/bin/sh -lc 'mkdir -p "$HOME/Documents/Workflowy/backups" && exec /usr/bin/python3 -m workflowy_importer.bridge_cli backup "$HOME/Documents/Workflowy/backups/$(date +%%F).json"'
NoNewPrivileges=true
PrivateTmp=true
